<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>About - EventFinder</title>
    <link rel="stylesheet" href="/stylesheets/about.css" />
  </head>
  <body>
    <section class="about-page">
      <!-- NAVBAR -->

      <nav>
        <div class="logo">
          <div class="logo-box">🎟</div>

          Nex<span>Event</span>
        </div>

        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <% if(user){ %>
            <li><a href="/add">Add Event</a></li> 
          <% } %>
          <li><a href="/read">Events</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <!-- HERO -->

      <div class="hero">
        <div class="hero-text">
          <h1>About <span>EventFinder</span></h1>

          <p>
            EventFinder is a modern event management platform where users can
            discover, create and manage amazing events around them. From
            concerts and tech meetups to business conferences and sports events,
            EventFinder helps people connect through unforgettable experiences.
          </p>

          <button class="hero-btn">
            <a href="/read">Explore Events</a>
          </button>
        </div>

        <div class="hero-image">
          <img
            src="/image/event.avif"
          />
        </div>
      </div>

      <!-- FEATURES -->

      <h2 class="section-title">Why Choose <span>Us</span></h2>

      <div class="features">
        <div class="feature-card">
          <div class="feature-icon">🎵</div>

          <h3>Discover Events</h3>

          <p>
            Explore trending concerts, workshops, food festivals and many more
            exciting events.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🚀</div>

          <h3>Create Events</h3>

          <p>
            Easily create and manage your own events with premium event
            management tools.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🎟</div>

          <h3>Online Tickets</h3>

          <p>
            Generate QR code tickets and allow users to book events instantly.
          </p>
        </div>

        <div class="feature-card">
          <div class="feature-icon">🌍</div>

          <h3>Global Community</h3>

          <p>
            Connect with people worldwide and join events from different
            categories.
          </p>
        </div>
      </div>

      <!-- STATS -->

      <div class="stats">
        <div class="stat-box">
          <h2>250+</h2>

          <p>Events Hosted</p>
        </div>

        <div class="stat-box">
          <h2>120+</h2>

          <p>Locations</p>
        </div>

        <div class="stat-box">
          <h2>5000+</h2>

          <p>Happy Users</p>
        </div>

        <div class="stat-box">
          <h2>24/7</h2>

          <p>Support Available</p>
        </div>
      </div>
    </section>
  </body>
</html>
