<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    
  </head>
  <body>
    <div class="main">
    <div class="form">
        <form action="/create" method="post">
          <input
            class="block"
            type="text"
            placeholder="Title goes here"
            name="title"
          />
          <textarea
            class="block"
            placeholder="write your task here"
            name="details"
          ></textarea>
          <input class="button" type="submit" value="create Task"/>
        </form>
      </div>
      <div class="tasks">
        <% if (files.length > 0) { %>
           <% files.forEach(function(val) { %>
              <div class="task">
                <h1 class="tasktitle"><%= val %></h1>
                <div class="links">
                 <a class="readtask" href="/file/<%= val %>">Read more</a>
                 <a class="readtask" href="/edit/<%= val %>">Edit name</a>
                </div> 
              </div>
            <% }) %> 
        <% } else { %>  <h1 class="tasktitle">No task found</h1>
        <% } %>
      </div>
    </div>
  </body>
</html>
