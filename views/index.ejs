<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>ZenVibe</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <section class="hero">
      <!-- NAVBAR -->

      <nav>
        <div class="logo">
          <div class="logo-box">🎟</div>

          Nex<span>Event</span>
        </div>

        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <% if(user){ %>
            <li><a href="/add">Add Event</a></li>
          <% } %>
          <li><a href="/read">Events</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>

        <div class="nav-buttons">
          <% if(user){ %>
            <span class="username">Hello, <%= user.fullname %></span>
            <a href="/logout" class="logout-btn">Logout</a>
          <% } else { %>
             <a href="/login" class="login-btn">Login</a>
             <a href="/signup" class="signup-btn">Sign Up</a>
          <% } %>
        </div>
      </nav>

      <!-- HERO CONTENT -->

      <div class="hero-content">
        <h1>Discover Amazing <span>Events</span></h1>

        <p>
          Find concerts, workshops, parties and more exciting events happening
          around you.
        </p>

        <div class="hero-btns">
            <a href="/read" class="btn primary-btn">Explore Events</a>
            <a href="/add" class="btn secondary-btn">Create Event</a>
        </div>

        <!-- SEARCH -->

        <div class="search-box">
          <input type="text" placeholder="Search events..." />

          <button class="search">Search</button>
        </div>

        <div class="category-chips">
          <span class="chip">🎵 Music</span>
          <span class="chip">🎨 Tech</span>
          <span class="chip">🎮 Gaming</span>
          <span class="chip">🍕 Food & Drinks</span>
          <span class="chip">⚽ Sports</span>
        </div>
        <!-- STATS -->

        <div class="stats">
          <div class="stat">
            <h2>250+</h2>
            <p>Events</p>
          </div>

          <div class="stat">
            <h2>120+</h2>
            <p>Locations</p>
          </div>

          <div class="stat">
            <h2>5000+</h2>
            <p>Happy Users</p>
          </div>
        </div>
      </div>
    </section>
  </body>
</html>
