<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/style.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
    <div class="p-10 w-full h-full bg-zinc-900 text-white">
      <div><a href="/read">Read user</a></div>
      <form action="/create" method="post">
        <h3 class="text-3xl tracking-tighter mb-2">Create user</h3>
        <input
          class="px-5 py-2 border-5 border-zinc-800 rounded-lg bg-transparent"
          type="text"
          placeholder="Name"
          name="name"
        />
        <input
          class="px-5 py-2 border-5 border-zinc-800 rounded-lg bg-transparent"
          type="text"
          placeholder="Email Address"
          name="email"
        />
        <input
          class="px-5 py-2 border-5 border-zinc-800 rounded-lg bg-transparent"
          type="text"
          placeholder="Image URL"
          name="image"
        />
        <input
          class="px-5 py-2 ml-3 rounded-lg bg-blue-500"
          type="submit"
          value="Create user"
        />
      </form>
    </div>
  </body>
</html>
