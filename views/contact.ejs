<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />

    <title>Contact - EventFinder</title>

    <link rel="stylesheet" href="/stylesheets/contact.css" />
  </head>
  <body>
    <section class="contact-page">
      <!-- NAVBAR -->

      <nav>
        <div class="logo">
          <div class="logo-box">🎟</div>

          Event<span>Finder</span>
        </div>

        <ul class="nav-links">
          <li><a href="/">Home</a></li>
          <li><a href="/read">Events</a></li>
          <li><a href="/add">Add Event</a></li>
          <li><a href="/about">About</a></li>
          <li><a href="/contact">Contact</a></li>
        </ul>
      </nav>

      <!-- HEADER -->

      <div class="contact-header">
        <h1>Contact <span>Us</span></h1>

        <p>Have questions or suggestions? We'd love to hear from you.</p>
      </div>

      <!-- CONTACT SECTION -->

      <div class="contact-container">
        <!-- LEFT -->

        <div class="contact-info">
          <h2>Get In Touch</h2>

          <p>
            Connect with EventFinder for support, partnerships, event
            collaborations or any questions regarding the platform.
          </p>

          <div class="info-box">
            <div class="icon">📍</div>

            <div class="info-text">
              <h3>Location</h3>

              <span>Bhopal, India</span>
            </div>
          </div>

          <div class="info-box">
            <div class="icon">📞</div>

            <div class="info-text">
              <h3>Phone</h3>

              <span>+91 9876543210</span>
            </div>
          </div>

          <div class="info-box">
            <div class="icon">✉</div>

            <div class="info-text">
              <h3>Email</h3>

              <span>Pawanthakre@eventfinder.com</span>
            </div>
          </div>
        </div>

        <!-- RIGHT -->

        <div class="contact-form">
          <h2>Send Message</h2>

          <div class="form-group">
            <input type="text" placeholder="Enter your name" />
          </div>

          <div class="form-group">
            <input type="email" placeholder="Enter your email" />
          </div>

          <div class="form-group">
            <input type="text" placeholder="Subject" />
          </div>

          <div class="form-group">
            <textarea placeholder="Write your message"></textarea>
          </div>

          <button class="submit-btn">Send Message</button>
        </div>
      </div>
    </section>
  </body>
</html>
