<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Document</title>
    <link rel="stylesheet" href="/stylesheets/read.css" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  </head>
  <body>
  <div class="hero">
      <!-- NAVBAR -->
      <nav>
        <div class="logo">
          <div class="logo-box">🎟</div>

          Zen<span>Vibe</span>
        </div>

        <ul class="nav-links">
          <li><a href="/">Home</a></li>

          <li><a href="/read">Events</a></li>

          <li><a href="/add">Add Event</a></li>

          <li><a href="/about">About</a></li>

          <li><a href="/contact">Contact</a></li>
        </ul>

        <div class="profile">
          <p>Pawan Thakre</p>
        </div>
      </nav>

      <!-- TITLE -->

        <div class="title-section">
         <h1>All Events</h1>

          <p>Discover and Join Amazing Events</p>
        </div>

      <!-- FILTERS -->

        <div class="filters">
          <input
          class="search-box"
          type="text"
          placeholder="🔍 Search events..."
           />
       </div>
      <div class=" flex flex-wrap gap-3 ">
        <% events.forEach(function (event) { %>

          <div class="w-80 bg-slate-900 rounded-2xl overflow-hidden shadow-xl m-3 font-sans border border-slate-800">
                 <div class="w-full h-48 bg-slate-800">
                     <img class="w-full h-full object-cover" src="<%= event.image %>" alt="Event Image">
                 </div>

                <div class="p-6">
                    <h3 class="text-2xl font-bold text-white flex items-center gap-2">
                    <svg class="w-6 h-6 text-white" fill="none" stroke="currentColor" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4.318 6.318a4.5 4.5 0 000 6.364L12 20.364l7.682-7.682a4.5 4.5 0 00-6.364-6.364L12 7.636l-1.318-1.318a4.5 4.5 0 00-6.364 0z"></path>
                    </svg>
                    <%=event.eventtitle %>
                    </h3>

                        <div class="mt-4">
                        <span class="bg-indigo-900/60 text-indigo-300 text-sm font-semibold px-4 py-1.5 rounded-full inline-block">
                         <%= event.category %>
                        </span>
                        </div>

                          <div class="mt-6 space-y-3 text-gray-200 font-medium">
                            <div class="flex items-center gap-3">
                            <span class="text-xl">📅</span>
                            <p><%= event.date %></p>
                            </div>
                                   <div class="flex items-center gap-3">
                                   <span class="text-xl">⏰</span>
                                   <p><%= event.time %></p>
                                   </div>
                                          <div class="flex items-center gap-3">
                                          <span class="text-pink-500 text-xl">📍</span>
                                          <p><%= event.location %></p>
                                          </div>
                                              <div class="flex items-center gap-3">
                                              <span class="text-pink-500 text-xl">📞</span>
                                              <p><%= event.contact %></p>
                                              </div>
                          </div>

                                               <p class="mt-5 text-gray-300 text-sm leading-relaxed">
                                               <%= event.description %>
                                               </p>

                                              <div class="flex gap-4 mt-8">
                                               <a href="/edit/<%= event._id %>" class="flex-1 bg-[#8b5cf6] hover:bg-[#7c3aed] text-white font-bold py-3 rounded-xl text-center transition-colors">
                                               Edit Event
                                               </a>
                                               <a href="/delete/<%= event._id %>" class="flex-1 bg-[#8b5cf6] hover:bg-[#7c3aed] text-white font-bold py-3 rounded-xl text-center transition-colors">
                                                Delete
                                                </a>
                                              </div>
                </div>
      </div>
        <% }) %>
     </div>
   </div>
  </body>
</html>
